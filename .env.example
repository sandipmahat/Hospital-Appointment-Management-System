SECRET_KEY=replace-with-a-long-random-value

# Local MySQL connection settings.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=hospital_appointments

# Set SESSION_COOKIE_SECURE=true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=60

# INIT_DB creates the database and tables on application startup.
# Leave this disabled unless you want the app to initialize MySQL on launch.
INIT_DB=false
CSRF_ENABLED=true
